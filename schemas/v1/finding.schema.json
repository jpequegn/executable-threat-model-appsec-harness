{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-harness.dev/schemas/v1/finding.schema.json",
  "title": "Candidate Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "trial_id", "component", "location", "hypothesis", "attack_preconditions", "claimed_impact", "asset_id", "evidence", "discovery_adapter", "confidence"],
  "properties": {
    "schema_version": {"const": "appsec-harness.dev/v1"},
    "id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "component": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "attack_preconditions": {"type": "array", "items": {"type": "string"}},
    "claimed_impact": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "discovery_adapter": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
