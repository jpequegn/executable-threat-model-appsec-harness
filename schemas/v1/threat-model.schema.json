{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-harness.dev/schemas/v1/threat-model.schema.json",
  "title": "Threat Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "owner", "review_date", "evidence_sources", "assets", "identities", "trust_boundaries", "entry_points", "dependencies", "assumptions", "controls", "invariants"],
  "properties": {
    "schema_version": {"const": "appsec-harness.dev/v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "review_date": {"type": "string", "format": "date"},
    "evidence_sources": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "identities": {"type": "array", "items": {"$ref": "#/$defs/identity"}},
    "trust_boundaries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/boundary"}},
    "entry_points": {"type": "array", "items": {"$ref": "#/$defs/entryPoint"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "controls": {"type": "array", "items": {"$ref": "#/$defs/control"}},
    "invariants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/invariant"}}
  },
  "$defs": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "uri"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1}, "digest": {"type": "string"}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["id", "name", "classification"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "classification": {"type": "string", "minLength": 1}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["id", "roles"], "properties": {"id": {"type": "string", "minLength": 1}, "roles": {"type": "array", "items": {"type": "string"}}}},
    "boundary": {"type": "object", "additionalProperties": false, "required": ["id", "name", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "entryPoint": {"type": "object", "additionalProperties": false, "required": ["id", "method", "path", "boundary_id"], "properties": {"id": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "boundary_id": {"type": "string", "minLength": 1}}},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["id", "name", "endpoint", "local"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "endpoint": {"type": "string", "minLength": 1}, "local": {"type": "boolean"}}},
    "assumption": {"type": "object", "additionalProperties": false, "required": ["id", "text", "evidence"], "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}}},
    "control": {"type": "object", "additionalProperties": false, "required": ["id", "description", "asset_ids", "evidence"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "asset_ids": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "string", "minLength": 1}}},
    "invariant": {"type": "object", "additionalProperties": false, "required": ["id", "description", "asset_ids", "control_ids", "kind"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "asset_ids": {"type": "array", "items": {"type": "string"}}, "control_ids": {"type": "array", "items": {"type": "string"}}, "kind": {"enum": ["required", "prohibited"]}}}
  }
}
